# PDFForge — Debian GNOME low-spec environment (template)
# The install script replaces @REPO@ with the actual repository path.
# Tuned for: AMD A9-9420 (2-core) · 4 GB RAM · 128 GB SSD

APP_ENV=production

# SQLite (absolute path, single file) — no MySQL needed on a mini server.
DATABASE_URL=sqlite:///@REPO@/data/pdfforge.db

# Shared temp dir so API and worker see the same files.
TEMP_DIR=@REPO@/data/tmp

# ── Low-spec tuning ─────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=40
MAX_PAGES=300
MAX_CONCURRENT_JOBS=1        # critical: 2 jobs would blow past 4 GB RAM
JOB_TTL_MINUTES=15
CLEANUP_INTERVAL_MINUTES=5

RATE_LIMIT_ENABLED=true
RATE_LIMIT_JOBS_PER_HOUR=10

CORS_ORIGINS=http://localhost
