# ── PDFForge configuration ──────────────────────────────────────────────
# Copy to `.env` and adjust. Never commit the real `.env`.

APP_ENV=production

# Services
API_PORT=8000
WEB_PORT=3000
API_HOST=0.0.0.0

# Database (SQLite for dev / MVP, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/pdfforge.db

# Storage
TEMP_DIR=/tmp/pdfforge

# Limits
MAX_FILE_SIZE_MB=100
MAX_PAGES=500
MAX_CONCURRENT_JOBS=2
JOB_TTL_MINUTES=30

# Routing threshold: files larger than this (MB) go server-side
CLIENT_SIDE_MAX_MB=40

# Queue (future: Redis)
REDIS_URL=redis://redis:6379

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_JOBS_PER_HOUR=10

# Cleanup interval
CLEANUP_INTERVAL_MINUTES=5

# CORS (comma separated origins allowed in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
