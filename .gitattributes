# Normalize line endings on commit and always check out LF, regardless of the
# developer's OS. CRLF in a tracked shell script breaks Linux (`bad interpreter`).
* text=auto eol=lf

# Shell scripts run on Linux/macOS and must stay LF.
*.sh text eol=lf

# Windows-only scripts must keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never convert or diff as text.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
